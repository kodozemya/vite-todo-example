# Залежності: їх ставить `npm install` за package-lock.json.
# У репозиторії їм не місце — це десятки тисяч файлів, які в кожного
# однакові й відновлюються однією командою.
node_modules

# Результат збірки: `npm run build` створює його заново з вихідників.
# Комітити зібране — те саме, що комітити скріншот замість коду.
dist

# Логи й службові файли
*.log
.DS_Store

# Локальні змінні оточення
.env
.env.local
